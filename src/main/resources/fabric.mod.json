{
	"schemaVersion": 1,
	"id": "glade_archive",
	"version": "${version}",
	"name": "Glade - Archive",
	"description": "Archive module for The Far Glade. Requires glade-core.",
	"authors": ["DarkShamanism"],
	"environment": "client",
	"entrypoints": {
		"glade:module": [{ "value": "com.darkshamanism.lotcscholar.modules.archive.ArchiveModule", "adapter": "kotlin" }]
	},
	"mixins": [
		{ "config": "glade-archive.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"gladecore": "*"
	},
	"custom": {
		"modmenu": { "parent": "gladecore" }
	}
}
